{
  "routes": [
    {
      "route": "/*",
      "rewrite": "/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*", "/css/*", "/js/*", "*.svg", "*.png", "*.jpg", "*.gif", "*.ico", "*.json"]
  },
  "mimeTypes": {
    ".json": "text/json",
    ".wasm": "application/wasm"
  }
}
